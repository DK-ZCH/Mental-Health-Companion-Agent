<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.StudentDao">

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        a.id as id
        ,a.username as username
        ,a.password as password
        ,a.name as name
        ,a.phone as phone
        ,a.id_card_no as idCardNo
        ,a.avatar_url as avatarUrl
        ,a.gender as gender
        ,a.email as email
        ,a.created_at as createdAt
    </sql>
    <select id="selectListView" parameterType="map" resultType="com.entity.view.StudentView" >
        SELECT
        <include refid="Base_Column_List" />

--         级联表的字段

        FROM student  a

        <where>
            <if test="params.ids != null">
                and a.id in
                <foreach item="item" index="index" collection="params.ids" open="(" separator="," close=")">
                #{item}
                </foreach>
            </if>
            <!-- D2-2b-G2：读范围收敛 —— 学生表以【自身主键 id】作为归属字段（表内无 student_id / counselor_id） -->
            <!-- 服务端由 DataScope 注入 params.studentId = 当前登录学生 userId；管理员不注入 => 条件不生效（保持全量） -->
            <!-- 教师侧映射（AUTHZ-COUNSELOR-STUDENT-SCOPE，原 G3 挂账）：
                 心理老师仅可访问与其存在【已批准预约】的学生。
                 · 关联字段为 counseling_appointment.student_id / counselor_id，
                   绝不使用 student.id = counselor.id（两者是独立 id 空间）
                 · status 由 Java 常量经 params.approvedStatus 传入，SQL 中不写死数字
                 · 若 approvedStatus 漏传 ⇒ 条件恒不匹配 ⇒ 查不到数据（fail-closed，方向安全）
                 · 语义与 AssessmentRecordDao 的同名规则一致（同一 EXISTS 判定口径） -->
            <if test="params.counselorId != null and params.counselorId != ''">
                and exists (
                    select 1
                    from counseling_appointment ca
                    where ca.student_id   = a.id
                      and ca.counselor_id = #{params.counselorId}
                      and ca.status       = #{params.approvedStatus}
                )
            </if>
            <if test="params.studentId != null and params.studentId != ''">
                and a.id = #{params.studentId}
            </if>
            <if test=" params.username != '' and params.username != null and params.username != 'null' ">
                and a.username like CONCAT('%',#{params.username},'%')
            </if>
            <if test=" params.password != '' and params.password != null and params.password != 'null' ">
                and a.password like CONCAT('%',#{params.password},'%')
            </if>
            <if test=" params.name != '' and params.name != null and params.name != 'null' ">
                and a.name like CONCAT('%',#{params.name},'%')
            </if>
            <if test=" params.phone != '' and params.phone != null and params.phone != 'null' ">
                and a.phone like CONCAT('%',#{params.phone},'%')
            </if>
            <if test=" params.idCardNo != '' and params.idCardNo != null and params.idCardNo != 'null' ">
                and a.id_card_no like CONCAT('%',#{params.idCardNo},'%')
            </if>
            <if test="params.gender != null and params.gender != ''">
                and a.gender = #{params.gender}
            </if>
            <if test=" params.email != '' and params.email != null and params.email != 'null' ">
                and a.email like CONCAT('%',#{params.email},'%')
            </if>

        </where>

        order by a.${params.orderBy} desc 
    </select>

</mapper>