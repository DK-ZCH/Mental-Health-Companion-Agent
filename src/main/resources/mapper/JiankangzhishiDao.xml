<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.JiankangzhishiDao">

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        a.id as id
        ,a.title as title
        ,a.cover_url as coverUrl
        ,a.category as category
        ,a.published_at as publishedAt
        ,a.content as content
        ,a.created_at as createdAt
    </sql>
    <select id="selectListView" parameterType="map" resultType="com.entity.view.JiankangzhishiView" >
        SELECT
        <include refid="Base_Column_List" />

--         级联表的字段

        FROM knowledge_article  a

        <where>
            <if test="params.ids != null">
                and a.id in
                <foreach item="item" index="index" collection="params.ids" open="(" separator="," close=")">
                #{item}
                </foreach>
            </if>
            <if test=" params.title != '' and params.title != null and params.title != 'null' ">
                and a.title like CONCAT('%',#{params.title},'%')
            </if>
            <if test="params.category != null and params.category != ''">
                and a.category = #{params.category}
            </if>
            <if test=" params.publishedAtStart != '' and params.publishedAtStart != null ">
                <![CDATA[  and UNIX_TIMESTAMP(a.published_at) >= UNIX_TIMESTAMP(#{params.publishedAtStart}) ]]>
            </if>
            <if test=" params.publishedAtEnd != '' and params.publishedAtEnd != null ">
                <![CDATA[  and UNIX_TIMESTAMP(a.published_at) <= UNIX_TIMESTAMP(#{params.publishedAtEnd}) ]]>
            </if>
            <if test=" params.content != '' and params.content != null and params.content != 'null' ">
                and a.content like CONCAT('%',#{params.content},'%')
            </if>

        </where>

        order by a.${params.orderBy} desc 
    </select>

</mapper>